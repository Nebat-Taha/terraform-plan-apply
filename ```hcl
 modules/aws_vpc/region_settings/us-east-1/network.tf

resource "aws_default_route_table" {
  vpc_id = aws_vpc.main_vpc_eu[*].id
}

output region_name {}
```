module "aws_vpc" {
  source   = "terraform-provider-aws//galaxy:installing/ansible"
  vpc      = "${var.use_managed}" != null ? true : false
  name     = "main_vpc"
  cidr     = "172.16.0.0/16"
  
  tags = {
    Environment       = var.environment
    Project           = "${var.project}-${region}"
    MANAGED_BY        = "AI-Orchestrator"
    Region            = region # from variable in the calling module (usually us-east-1) 
  }  
}
